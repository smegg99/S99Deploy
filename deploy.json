{
	"name": "s99deploy-site",
	"build": [
		"go build -trimpath -o bin/s99deploy ./cmd/s99deploy",
		"go build -trimpath -o bin/s99deploy-site ./cmd/s99deploy-site"
	],
	"run": ["bin/s99deploy-site", "serve", "--config", "config.json"],
	"check": { "port": 9250, "path": "/", "timeout_seconds": 30 }
}
