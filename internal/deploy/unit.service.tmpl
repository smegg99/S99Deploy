# internal/deploy/unit.service.tmpl
[Unit]
Description={{.Name}} (managed by s99deploy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.Name}}
Group={{.Name}}

WorkingDirectory={{.Root}}/app
ExecStart={{.SelfPath}} run {{.Root}}

# systemd takes $HOME from passwd, which is the root-owned app root, so the
# service is given the same writable home the build commands run with.
# Environment= beats what the service manager derives; EnvironmentFile= below
# beats Environment=, so a deliberate HOME in .env still wins.
Environment=HOME={{.Root}}/home

# Secrets are root-owned, outside the checkout, so the account cannot read or
# replace them and a git operation can never touch them.
EnvironmentFile={{.Root}}/.env

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_UNIX is not a network family. The resolver, journald's /dev/log, D-Bus and
# any S99AB work/daemon socket need it. AF_PACKET and AF_NETLINK, the families
# this option exists to block, stay blocked.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Under ProtectSystem=strict systemd refuses to start if a ReadWritePaths entry
# is missing. The account writes only the checkout and its own home, both of
# which install lays out, so the root that holds .env stays read-only.
ReadWritePaths={{.Root}}/app {{.Root}}/home

[Install]
WantedBy=multi-user.target
